{
  "manifest_version": 3,
  "name": "VinFast DMS Auto Silent Sync",
  "version": "1.2.0",
  "description": "Tự động chạy ngầm đồng bộ Kho xe & nạp thongtinxe từ VinFast DMS về Supabase",
  "content_scripts": [
    {
      "matches": [
        "https://*.dynamics.com/*",
        "https://*.crm.dynamics.com/*",
        "https://*.crm4.dynamics.com/*",
        "https://*.crm5.dynamics.com/*",
        "https://*.vinfast.vn/*",
        "https://*.powerapps.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
