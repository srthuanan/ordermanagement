{
  "manifest_version": 3,
  "name": "VinFast DMS Auto Silent Sync",
  "version": "2.2.0",
  "description": "Tự động chạy ngầm đồng bộ Số máy, Mã DMS đa đại lý, Kho xe, thongtinxe & donhanghienhuu trên cả DMS Mới (dealer-portal.vinfast.com) và DMS Cũ (Dynamics)",
  "content_scripts": [
    {
      "matches": [
        "https://dealer-portal.vinfast.com/*",
        "https://*.vinfast.com/*",
        "https://*.dynamics.com/*",
        "https://*.crm.dynamics.com/*",
        "https://*.crm4.dynamics.com/*",
        "https://*.crm5.dynamics.com/*",
        "https://*.vinfast.vn/*",
        "https://*.powerapps.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://dealer-portal.vinfast.com/*"
      ],
      "js": [
        "ndp-session.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "background": {
    "service_worker": "session-background.js"
  },
  "permissions": [
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:3001/*",
    "https://dealer-portal.vinfast.com/*"
  ]
}
